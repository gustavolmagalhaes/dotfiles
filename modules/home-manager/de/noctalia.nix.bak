{ config, pkgs, inputs, ... }:
{
  imports = [
    inputs.noctalia.homeModules.default
  ];

  programs.noctalia = {
    enable = true;
    systemd.enable = true;

    settings = {
      # Theme and general palette overrides
      theme = {
        mode = "dark";
      };

      # Custom color palette definitions mapping to your requirements
      palette = {
        background = "#000000";
        surface = "#000000";
        primary = "#FFA500";
        cyan = "#00FFFF";
        tertiary = "#00FFFF";
      };

      # Top Bar Layout and Styling Configuration
      bar = {
        default = {
          position = "top";
          thickness = 36;
          background = "#000000";
          margin = 0;
          rounding = 0;
        };

        left = [
          "launcher"
          "workspaces"
        ];

        center = [
          "mediaPlayer"
        ];

        right = [
          "tray"
          "network"
          "volume"
          "brightness"
          "battery"
          "clock"
          "controlCenter"
        ];
      };

      widgets = {
        workspaces = {
          highlight_color = "#FFA500";
          show_badge = true;
        };

        network = {
          color = "#00FFFF";
          show_ip = true;
          show_speed = false;
        };

        battery = {
          dynamic_color = true;
          show_percentage = true;
        };
      };
    };
  };
}
